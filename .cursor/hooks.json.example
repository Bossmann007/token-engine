{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "command": "./hooks/token-engine-session.py"
      }
    ],
    "postToolUse": [
      {
        "command": "./hooks/compress-tool-output.py",
        "matcher": "Shell|Read"
      },
      {
        "command": "./hooks/compress-mcp-output.py",
        "matcher": "MCP:.*"
      }
    ]
  }
}
