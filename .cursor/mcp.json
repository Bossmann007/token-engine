{
  "mcpServers": {
    "token-engine": {
      "command": "python3",
      "args": ["-m", "token_engine.mcp.server"],
      "env": {
        "PYTHONPATH": "${workspaceFolder}/src"
      }
    },
    "codebase-memory": {
      "command": "npx",
      "args": ["-y", "codebase-memory-mcp@latest"],
      "env": {}
    }
  }
}
