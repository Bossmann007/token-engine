{
  "encoding": "o200k_base",
  "quality_level": "balanced",
  "max_tokens": 128000,
  "target_tokens": 32000,
  "live_zone_mode": true,
  "enable_deduplication": true,
  "enable_cross_turn_dedup": true,
  "enable_cache": true,
  "enable_code_aware": true,
  "enable_tool_output_compression": true,
  "enable_smart_crusher": true,
  "enable_ccr": true,
  "enable_tool_schema_compaction": true,
  "enable_log_template_mining": true,
  "enable_toon_encoding": true,
  "enable_read_delta": true,
  "enable_knapsack_selection": true,
  "enable_read_lifecycle": true,
  "enable_compression_feedback": true,
  "enable_cache_aligner": true,
  "enable_sandbox_execute": true,
  "fail_closed": true,
  "tool_desc_max_chars": 120,
  "tool_desc_strip_semantic": true,
  "cache_ttl_seconds": 3600,
  "ccr_ttl_seconds": 1800
}
