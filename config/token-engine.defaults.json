{
  "encoding": "o200k_base",
  "quality_level": "balanced",
  "max_tokens": 128000,
  "target_tokens": 32000,
  "live_zone_mode": true,
  "enable_deduplication": true,
  "enable_cross_turn_dedup": true,
  "enable_cache": true,
  "enable_code_aware": true,
  "enable_tool_output_compression": true,
  "enable_smart_crusher": true,
  "enable_ccr": true,
  "enable_tool_schema_compaction": true,
  "enable_log_template_mining": true,
  "enable_toon_encoding": true,
  "enable_read_delta": true,
  "enable_knapsack_selection": true,
  "enable_hybrid_knapsack": true,
  "knapsack_budget_threshold": 0.8,
  "hybrid_knapsack_target_ratio": 0.95,
  "enable_read_lifecycle": true,
  "enable_compression_feedback": true,
  "enable_cache_aligner": true,
  "enable_sandbox_execute": false,
  "enable_rtk_filters": true,
  "enable_jev_router": false,
  "jev_model": "jev-latest",
  "jev_timeout_seconds": 5.0,
  "jev_max_candidates": 8,
  "jev_min_confidence_read": 0.5,
  "jev_min_confidence_write": 0.75,
  "jev_min_confidence_destructive": 1.01,
  "jev_data_minimization": true,
  "jev_redact_secrets": true,
  "jev_cache_ttl_seconds": 300,
  "jev_fallback_mode": "bm25",
  "jev_max_input_tokens": 2000,
  "jev_min_catalog_tools": 15,
  "jev_min_expected_token_savings": 200,
  "enable_cbm_bridge": true,
  "enable_session_semantic_compactor": true,
  "cbm_min_lines": 35,
  "cbm_min_chars": 800,
  "cbm_min_lines_session": 15,
  "cbm_min_chars_session": 400,
  "cbm_session_code_threshold": 200,
  "cbm_collapse_irrelevant": true,
  "enable_proactive_low_tier_collapse": true,
  "header_min_saved_tokens": 15,
  "header_min_original_tokens": 50,
  "knapsack_small_session_items": 8,
  "knapsack_small_session_threshold": 0.01,
  "enable_content_router": true,
  "query_slice_min_chars_session": 80,
  "ccr_min_token_saved": 100,
  "ccr_min_chars_saved": 400,
  "ccr_min_token_saved_critical": 150,
  "compact_output_headers": true,
  "show_token_savings_in_headers": true,
  "knapsack_large_session_items": 15,
  "knapsack_large_session_threshold": 0.6,
  "fail_closed_min_ratio": 0.03,
  "fail_closed": true,
  "tool_desc_max_chars": 120,
  "tool_desc_strip_semantic": true,
  "lazy_schema_default_level": "medium",
  "lazy_schema_min_tools": 20,
  "cache_ttl_seconds": 3600,
  "ccr_ttl_seconds": 1800
}
